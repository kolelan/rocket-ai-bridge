# Скопируйте этот файл в .env и подставьте свои значения.
# Файл .env в git не попадает.
#
# Пустая переменная считается незаданной. Кавычки вокруг значений не нужны.

# Базовый URL сервера Rocket.Chat, без слэша на конце.
# Пример: https://chat.example.com
ROCKET_URL=

# Личный токен доступа пользователя или бота.
# Rocket.Chat: аватар → My Account → Personal Access Tokens → Add.
# Это заголовок X-Auth-Token. Сюда не подходит пароль от входа в чат.
ROCKET_AUTH_TOKEN=

# Id пользователя, которому выдан токен.
# Его возвращает GET /api/v1/me в поле _id. Это заголовок X-User-Id.
ROCKET_USER_ID=

# --- Комнаты ---
# Id печатает: python get_rooms.py
#
# v1 и v2: вопросы читаются из DP_IN_ID, ответы пишутся в DP_OUT_ID.
# v2.5 и новее: DP_CTRL_ID — комната команд, DP_CHAT_ID — комната вопросов и ответов.
# Если это те же две комнаты, достаточно заполнить одну пару:
# DP_IN_ID подхватывается как DP_CTRL_ID и наоборот, DP_OUT_ID — как DP_CHAT_ID.

# Id комнаты вопросов (v1/v2, канал dp_in) или запасное имя для комнаты команд.
DP_IN_ID=

# Id комнаты ответов (v1/v2, канал dp_out) или запасное имя для комнаты работы.
DP_OUT_ID=

# Id комнаты команд (!new, !list, !help). Можно не заполнять, если задан DP_IN_ID.
DP_CTRL_ID=

# Id комнаты, куда пишут вопросы и куда бот отвечает. Можно не заполнять, если задан DP_OUT_ID.
DP_CHAT_ID=

# Секретный ключ API DeepSeek: https://platform.deepseek.com/api_keys
# Уходит заголовком Authorization: Bearer. Это не токен Rocket.Chat.
DEEPSEEK_API_KEY=

# Имя модели по умолчанию для v1. Не секрет. Пусто — deepseek-v4-pro.
DEEPSEEK_MODEL=deepseek-v4-pro

# Каталог данных (chats, archives, log, state.json).
# Пусто — папка, в которой лежит bridge.py.
WORK_DIR=

# --- Только для create_bot.py ---
# Скрипт создаёт пользователя от имени того, чей ROCKET_AUTH_TOKEN указан выше
# (нужны права администратора). Пароль придумайте новый, в код его не пишите.

# Логин латиницей.
BOT_USERNAME=

# Имя, которое видно в чате.
BOT_NAME=

# Почта учётной записи.
BOT_EMAIL=

# Длинный случайный пароль этой учётной записи.
BOT_PASSWORD=
